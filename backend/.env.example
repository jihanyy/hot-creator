HOTDATA_API_KEY=replace-with-your-hotdata-api-key
HOTDATA_API_BASE_URL=https://w-hotdata.aipromptnav.com/api/hot-data
HOTDATA_TIMEOUT_SECONDS=8
HOTDATA_CACHE_TTL_SECONDS=300
# OpenAI 兼容接口配置。切换服务商时需要同时更新以下三项。
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=replace-with-your-ai-api-key
# 本地 OpenAI 兼容模型无需 Key 时设为 true。
AI_ALLOW_EMPTY_KEY=true
# 模型没有代码默认值；填写服务商支持的模型 ID，修改后重启后端生效。
AI_MODEL=replace-with-provider-model-id
